{
  "name": "@xushnud_bek/auth-kit-js",
  "version": "0.1.2",
  "description": "Universal authentication library for Google, Facebook, and Telegram",
  "author": "Xushnud <xushnud9812@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xushnud9812/auth-kit-js.git"
  },
  "homepage": "https://xushnud9812.github.io/auth-kit-js/",
  "bugs": {
    "url": "https://github.com/Xushnud9812/auth-kit-js/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "import": "./dist/index.browser.js",
        "require": "./dist/index.browser.cjs",
        "types": "./dist/index.browser.d.ts"
      },
      "node": {
        "import": "./dist/index.node.js",
        "require": "./dist/index.node.cjs",
        "types": "./dist/index.node.d.ts"
      },
      "default": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs",
        "types": "./dist/index.d.ts"
      }
    },
    "./core": {
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs",
      "types": "./dist/core/index.d.ts"
    },
    "./frontend": {
      "browser": {
        "import": "./dist/frontend/index.js",
        "require": "./dist/frontend/index.cjs",
        "types": "./dist/frontend/index.d.ts"
      }
    },
    "./backend": {
      "node": {
        "import": "./dist/backend/index.js",
        "require": "./dist/backend/index.cjs",
        "types": "./dist/backend/index.d.ts"
      }
    },
    "./express": {
      "node": {
        "import": "./dist/adapters/express/index.js",
        "require": "./dist/adapters/express/index.cjs",
        "types": "./dist/adapters/express/index.d.ts"
      }
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.cjs",
    "dist/**/*.d.ts",
    "dist/**/*.d.cts",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": [
    "auth",
    "authentication",
    "oauth",
    "oauth2",
    "google",
    "facebook",
    "telegram",
    "login",
    "sso",
    "openid",
    "oidc",
    "typescript"
  ],
  "peerDependencies": {
    "express": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "express": "^4.18.2",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitepress": "^1.6.4",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
